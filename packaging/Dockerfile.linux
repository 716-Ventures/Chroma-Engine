# syntax=docker/dockerfile:1
# Reproducible portable Linux/DSM/QTS build:
# docker buildx build --platform linux/amd64 --output type=local,dest=dist/linux-x64 \
#   -f packaging/Dockerfile.linux .

FROM rust:1.90-bookworm AS builder

ARG DAV1D_COMMIT=b546257f770768b2c88258c533da38b91a06f737

RUN apt-get update \
    && apt-get install -y --no-install-recommends clang git libva-dev meson nasm ninja-build patchelf pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --filter=blob:none https://code.videolan.org/videolan/dav1d.git /tmp/dav1d \
    && git -C /tmp/dav1d checkout "$DAV1D_COMMIT" \
    && meson setup /tmp/dav1d/build /tmp/dav1d \
      --buildtype=release --default-library=shared \
      -Denable_tools=false -Denable_tests=false --prefix=/usr/local \
    && ninja -C /tmp/dav1d/build install \
    && ldconfig \
    && pkg-config --atleast-version=1.3.0 dav1d \
    && rm -rf /tmp/dav1d

WORKDIR /src
COPY . .

RUN CARGO_BUILD_JOBS=1 \
      CARGO_PROFILE_RELEASE_LTO=false \
      CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 \
      CARGO_TARGET_DIR=/tmp/chroma-target \
      cargo build --locked --release --features linux-vaapi --bin chroma-engine \
    && mkdir -p /runtime \
    && install -m0755 /tmp/chroma-target/release/chroma-engine /runtime/chroma-engine \
    && dav1d_lib="$(ldconfig -p | awk '/libdav1d\.so\.7/{print $NF; exit}')" \
    && test -n "$dav1d_lib" \
    && install -m0755 "$dav1d_lib" /runtime/libdav1d.so.7 \
    && patchelf --set-rpath '$ORIGIN' /runtime/chroma-engine \
    && LD_LIBRARY_PATH=/runtime /runtime/chroma-engine decoder-probe

# Run the actual bundle in the declared oldest supported userspace without
# graphics libraries or devices. The fixture contains original synthetic media.
RUN CARGO_BUILD_JOBS=1 CARGO_TARGET_DIR=/tmp/chroma-target \
      cargo run --locked --example make-test-media -- /fixture.mkv 6 \
    && cp THIRD_PARTY_NOTICES.md /runtime/ \
    && cp third_party/rusty_aac/LICENSE /runtime/rusty-aac-LICENSE \
    && printf '%s\n' 'libc=glibc-2.36' 'cpu=generic-x86-64-or-aarch64' \
      'features=linux-vaapi' 'rust=1.90' 'profile=release,lto=false,codegen-units=16,truehd-opt=0' \
      > /runtime/BUILD-BASELINE.txt

FROM debian:bookworm-slim AS baseline-test
RUN apt-get update && apt-get install -y --no-install-recommends libgcc-s1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /runtime/ /runtime/
COPY --from=builder /fixture.mkv /fixture.mkv
RUN /runtime/chroma-engine decoder-probe \
    && /runtime/chroma-engine cache-probe /tmp/chroma-cache \
    && CHROMA_RESOURCE_POLICY=small-nas /runtime/chroma-engine transcode-fmp4-segments \
      /fixture.mkv /tmp/chroma-cache --start-index 0 --count 2 --video-mode copy

FROM scratch AS bundle
COPY --from=baseline-test /runtime/ /
